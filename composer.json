{
    "name": "basaralieren-boop/veridogrula",
    "description": "VeriDoğrula - Profesyonel PHP Validation Kütüphanesi. Form verilerini, e-posta, telefon, şifre kuralları ve daha birçok şeyi doğrulayın.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Basaralieren",
            "email": "basaralieren@example.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "VeriDogrula\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VeriDogrula\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    }
}
